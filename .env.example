# Runtime
NODE_ENV=production
PORT=3000

# Public app URL after deployment, for example:
# APP_URL=https://opora-production.up.railway.app
APP_URL=

# AI providers. At least one is recommended for the assistant and research feed.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Database.
# Railway PostgreSQL automatically provides DATABASE_URL when the app is linked to the database.
# DATABASE_URL=postgresql://user:password@host:5432/db
DATABASE_URL=
# Keep SSL enabled for Railway public/internal Postgres URLs.
PGSSLMODE=require

# Supabase/PostgREST API for server-side persistence.
# Use SUPABASE_SERVICE_ROLE_KEY only on the server, never in frontend env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
